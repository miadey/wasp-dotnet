@* /stable — phpMyAdmin-style explorer for stable memory.
   Left: tree (Server → Collections → Keys). Right: value detail.
   State is encoded in the URL:
     ?c=<collection-name>          highlight collection, list keys
     ?c=<collection-name>&k=<id>   load + show one value
   Pure render-as-query: every click is an <a> the bridge picks up,
   no JS, no SignalR. *@

@page "/stable"

@{
    Wasp.AspNetCore.Blazor.Wasp.WaspContext.RouteQuery.TryGetValue("c", out var activeC);
    Wasp.AspNetCore.Blazor.Wasp.WaspContext.RouteQuery.TryGetValue("k", out var activeK);

    var collections = WaspSample.BlazorWasp.StableExplorer.All;
    var activeCol = string.IsNullOrEmpty(activeC)
        ? null
        : WaspSample.BlazorWasp.StableExplorer.Find(activeC);
    var pages = WaspSample.BlazorWasp.StableExplorer.StablePages;
    var bytes = WaspSample.BlazorWasp.StableExplorer.StableBytes;

    // Pagination: 100 keys/page, ?p=<page>.
    Wasp.AspNetCore.Blazor.Wasp.WaspContext.RouteQuery.TryGetValue("p", out var pStr);
    int page = 0;
    if (!string.IsNullOrEmpty(pStr)) int.TryParse(pStr, out page);
    if (page < 0) page = 0;
    const int PageSize = 100;

    IReadOnlyList<WaspSample.BlazorWasp.StableKey> keys = Array.Empty<WaspSample.BlazorWasp.StableKey>();
    int totalKeys = 0;
    WaspSample.BlazorWasp.StableValue? value = null;
    var editableFields = new HashSet<string>(StringComparer.Ordinal);
    if (activeCol is not null)
    {
        totalKeys = activeCol.Count;
        keys = activeCol.ListKeys(page * PageSize, PageSize);
        if (!string.IsNullOrEmpty(activeK)) value = activeCol.GetValue(activeK);
        foreach (var f in activeCol.EditableFields) editableFields.Add(f);
    }
    var canisterIdText = WaspSample.BlazorWasp.AdminService.CanisterIdText();
}

<PageTitle>Stable memory · explorer</PageTitle>

<div class="sx-shell">
    <aside class="sx-tree">
        <div class="sx-server">
            <div class="sx-server-row">
                <span class="sx-server-icon">⛁</span>
                <span class="sx-server-name">canister stable memory</span>
            </div>
            <div class="sx-server-meta">
                <span><b>@pages</b> pages</span>
                <span><b>@FormatBytes(bytes)</b></span>
                <span><b>@collections.Count</b> collections</span>
            </div>
        </div>

        <ul class="sx-tree-list">
            @foreach (var c in collections)
            {
                var isActive = activeCol is not null && c.Name == activeCol.Name;
                <li class="@(isActive ? "sx-col active" : "sx-col")">
                    <a class="sx-col-row" href="/stable?c=@c.Name">
                        <span class="sx-twisty">@(isActive ? "▾" : "▸")</span>
                        <span class="sx-col-name">@c.DisplayName</span>
                        <span class="sx-col-count">@c.Count</span>
                    </a>
                    <div class="sx-col-desc">@c.Description</div>
                    @if (isActive)
                    {
                        <ul class="sx-keys">
                            @if (keys.Count == 0)
                            {
                                <li class="sx-empty">empty</li>
                            }
                            @foreach (var k in keys)
                            {
                                var keyActive = k.Id == activeK ? "sx-key active" : "sx-key";
                                <li>
                                    <a class="@keyActive" href="/stable?c=@c.Name&k=@k.Id">
                                        <span class="sx-key-name">@k.Display</span>
                                        @if (k.Summary is not null)
                                        {
                                            <span class="sx-key-sum">@k.Summary</span>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                        @if (totalKeys > PageSize)
                        {
                            var lastPage = (totalKeys - 1) / PageSize;
                            <div class="sx-pager">
                                @if (page > 0)
                                {
                                    <a class="sx-page-btn" href="/stable?c=@c.Name&p=@(page - 1)">‹ prev</a>
                                }
                                <span class="sx-page-info">@(page + 1) / @(lastPage + 1)</span>
                                @if (page < lastPage)
                                {
                                    <a class="sx-page-btn" href="/stable?c=@c.Name&p=@(page + 1)">next ›</a>
                                }
                            </div>
                        }
                    }
                </li>
            }
        </ul>
    </aside>

    <section class="sx-detail">
        <div class="sx-auth" data-sx-canister="@canisterIdText">
            <div class="sx-auth-status" data-sx-status>
                <span class="sx-auth-dot" data-sx-dot></span>
                <span data-sx-label>anonymous · read-only</span>
            </div>
            <button type="button" class="sx-auth-btn" data-sx-login>Login with Internet Identity</button>
            <button type="button" class="sx-auth-btn sx-auth-btn-ghost" data-sx-logout style="display:none;">Logout</button>
        </div>
        @if (activeCol is null)
        {
            <div class="sx-blank">
                <div class="sx-blank-mark">⛁</div>
                <h2>Pick a collection on the left.</h2>
                <p>This canister has <b>@pages</b> pages
                   (<b>@FormatBytes(bytes)</b>) of stable memory
                   across <b>@collections.Count</b> registered collections.
                   Stable memory is the only canister state that survives
                   a Wasm upgrade — everything else is reset.</p>
            </div>
        }
        else if (value is null)
        {
            <div class="sx-blank">
                <div class="sx-meta">
                    <h2>@activeCol.DisplayName</h2>
                    <p class="sx-meta-line">@activeCol.Description</p>
                    <dl class="sx-kv">
                        <dt>Name</dt><dd><code>@activeCol.Name</code></dd>
                        <dt>Items</dt><dd>@activeCol.Count</dd>
                        <dt>Stable offset</dt><dd><code>@activeCol.StableOffset</code></dd>
                    </dl>
                </div>
                <p class="sx-hint">← pick a row to see its fields.</p>
            </div>
        }
        else
        {
            <header class="sx-detail-head">
                <div class="sx-crumb">
                    <a href="/stable">stable</a>
                    <span>/</span>
                    <a href="/stable?c=@activeCol.Name">@activeCol.DisplayName</a>
                    <span>/</span>
                    <span class="sx-crumb-leaf">@value.KeyId</span>
                </div>
            </header>
            <div class="sx-card">
                <table class="sx-fields">
                    <thead>
                        <tr><th>Field</th><th>Value</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var f in value.Fields)
                        {
                            var canEdit = editableFields.Contains(f.Name);
                            <tr data-sx-field="@f.Name" data-sx-editable="@(canEdit ? "1" : "0")">
                                <td class="sx-fname">@f.Name</td>
                                <td class="sx-fval" data-sx-fval data-sx-raw="@f.Value">@((MarkupString)RenderValue(f.Value))</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (editableFields.Count > 0)
                {
                    <div class="sx-edit-bar" data-sx-edit-bar style="display:none;">
                        <button type="button" class="sx-edit-save"
                                data-sx-save
                                data-sx-collection="@activeCol!.Name"
                                data-sx-key="@value.KeyId">Save changes</button>
                        <span class="sx-edit-msg" data-sx-msg></span>
                    </div>
                }
            </div>
        }
    </section>
</div>

