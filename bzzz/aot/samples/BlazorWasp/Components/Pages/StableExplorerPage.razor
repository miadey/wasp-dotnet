<script type="module">
    // Browser-side helper for /stable.
    //
    // Wires II login + signed update calls so that admin-gated edits
    // arrive at the canister with msg_caller == the user's II principal.
    // Plain fetch() POSTs to the canister land as anonymous, so they
    // can't be authorised — every edit MUST go through agent-js's
    // signed call path.
    //
    // Dependencies loaded from esm.sh CDN (no bundle in the canister).

    // esm.sh resolves transitive deps independently, which lands on a
    // candid version that's missing `bufFromBufLike` (renamed in 2.x).
    // ?deps= forces the whole dfinity tree onto a single version so
    // identity, agent and candid all agree on each other's exports.
    import { Actor, HttpAgent } from "https://esm.sh/@@dfinity/agent@@2.4.1?deps=@@dfinity/candid@@2.4.1,@@dfinity/principal@@2.4.1,@@dfinity/identity@@2.4.1,@@dfinity/agent@@2.4.1";
    import { AuthClient } from "https://esm.sh/@@dfinity/auth-client@@2.4.1?deps=@@dfinity/candid@@2.4.1,@@dfinity/principal@@2.4.1,@@dfinity/identity@@2.4.1,@@dfinity/agent@@2.4.1";
    import { IDL } from "https://esm.sh/@@dfinity/candid@@2.4.1?deps=@@dfinity/principal@@2.4.1";

    const root = document.querySelector(".sx-auth");
    if (!root) { /* page didn't render — bail */ } else {

    const canisterId = root.dataset.sxCanister;
    const dotEl   = root.querySelector("[data-sx-dot]");
    const labelEl = root.querySelector("[data-sx-label]");
    const loginBtn  = root.querySelector("[data-sx-login]");
    const logoutBtn = root.querySelector("[data-sx-logout]");

    const httpRequestIDL = IDL.Record({
        method:  IDL.Text,
        url:     IDL.Text,
        headers: IDL.Vec(IDL.Tuple(IDL.Text, IDL.Text)),
        body:    IDL.Vec(IDL.Nat8),
    });
    const httpResponseIDL = IDL.Record({
        status_code: IDL.Nat16,
        headers:     IDL.Vec(IDL.Tuple(IDL.Text, IDL.Text)),
        body:        IDL.Vec(IDL.Nat8),
        upgrade:     IDL.Opt(IDL.Bool),
    });
    const idlFactory = ({ IDL }) => IDL.Service({
        http_request:        IDL.Func([httpRequestIDL], [httpResponseIDL], ["query"]),
        http_request_update: IDL.Func([httpRequestIDL], [httpResponseIDL], []),
    });

    let authClient, identity, agent, actor;
    let whoami = { principal: "2vxsx-fae", isAdmin: false, isController: false };

    async function ensureAgent() {
        authClient = await AuthClient.create();
        identity = authClient.getIdentity();
        agent = new HttpAgent({ identity, host: "https://icp0.io" });
        actor = Actor.createActor(idlFactory, { agent, canisterId });
    }

    async function callCanisterHttp(method, url, jsonBody) {
        const bodyBytes = jsonBody
            ? Array.from(new TextEncoder().encode(jsonBody))
            : [];
        const req = {
            method, url,
            headers: jsonBody ? [["content-type", "application/json"]] : [],
            body: bodyBytes,
        };
        // Always use update calls — query calls go through a different
        // dispatcher that doesn't return MapGet bodies, so whoami via
        // query lands empty. Update calls are signed + replicated
        // (~1.5 s) but match what the user expects for both reads of
        // their own auth state and admin-gated writes.
        const fn = actor.http_request_update;
        const resp = await fn(req);
        const text = new TextDecoder().decode(new Uint8Array(resp.body));
        return { status: Number(resp.status_code), text };
    }

    async function refreshWhoami() {
        try {
            const r = await callCanisterHttp("GET", "/api/admin/whoami");
            whoami = JSON.parse(r.text);
        } catch (e) {
            whoami = { principal: "2vxsx-fae", isAdmin: false, isController: false };
        }
        renderAuth();
        renderEditUi();
    }

    function renderAuth() {
        const isLoggedIn = whoami.principal !== "2vxsx-fae";
        const tier = whoami.isAdmin ? "admin"
            : whoami.isController ? "controller"
            : isLoggedIn ? "logged in · not admin"
            : "anonymous · read-only";
        dotEl.classList.remove("sx-ok", "sx-warn");
        if (whoami.isAdmin || whoami.isController) dotEl.classList.add("sx-ok");
        else if (isLoggedIn) dotEl.classList.add("sx-warn");
        const short = whoami.principal.length > 14
            ? whoami.principal.slice(0, 5) + "…" + whoami.principal.slice(-3)
            : whoami.principal;
        labelEl.textContent = isLoggedIn ? `${short} · ${tier}` : tier;
        labelEl.title = whoami.principal;
        loginBtn.style.display  = isLoggedIn ? "none" : "";
        logoutBtn.style.display = isLoggedIn ? "" : "none";
    }

    function renderEditUi() {
        const editBar = document.querySelector("[data-sx-edit-bar]");
        if (!editBar) return;
        const rows = document.querySelectorAll("tr[data-sx-editable='1']");
        if (!whoami.isAdmin) {
            // Read-only: leave the table alone, hide save bar.
            editBar.style.display = "none";
            return;
        }
        editBar.style.display = "";
        rows.forEach(tr => {
            const fval = tr.querySelector("[data-sx-fval]");
            if (!fval || fval.querySelector(".sx-edit-input")) return;
            const raw = fval.dataset.sxRaw || "";
            fval.innerHTML = "";
            const input = document.createElement("input");
            input.type = "text";
            input.className = "sx-edit-input";
            input.value = raw;
            input.dataset.sxFieldInput = tr.dataset.sxField;
            fval.appendChild(input);
        });
    }

    loginBtn.addEventListener("click", async () => {
        loginBtn.disabled = true;
        await ensureAgent();
        await new Promise((resolve, reject) => authClient.login({
            identityProvider: "https://identity.ic0.app",
            maxTimeToLive: 8n * 60n * 60n * 1_000_000_000n,  // 8h in nanos
            onSuccess: resolve,
            onError: reject,
        }));
        await ensureAgent();   // rebuild agent with the freshly-stored identity
        loginBtn.disabled = false;
        await refreshWhoami();
    });

    logoutBtn.addEventListener("click", async () => {
        if (!authClient) return;
        await authClient.logout();
        await ensureAgent();
        await refreshWhoami();
    });

    document.addEventListener("click", async (ev) => {
        const btn = ev.target.closest("[data-sx-save]");
        if (!btn) return;
        if (!whoami.isAdmin) return;
        const msg = document.querySelector("[data-sx-msg]");
        const collection = btn.dataset.sxCollection;
        const key = btn.dataset.sxKey;
        const patch = {};
        document.querySelectorAll("input[data-sx-field-input]")
            .forEach(i => { patch[i.dataset.sxFieldInput] = i.value; });
        btn.disabled = true;
        msg.textContent = "saving…";
        msg.className = "sx-edit-msg";
        try {
            const body = JSON.stringify({ collection, key, patch });
            const r = await callCanisterHttp("POST", "/api/admin/stable_edit", body);
            const parsed = (() => { try { return JSON.parse(r.text); } catch { return {}; } })();
            if (r.status === 200 && parsed.ok) {
                msg.textContent = "saved · reloading…";
                msg.className = "sx-edit-msg sx-ok";
                setTimeout(() => location.reload(), 600);
            } else {
                msg.textContent = "error: " + (parsed.error || r.status);
                msg.className = "sx-edit-msg sx-err";
            }
        } catch (e) {
            msg.textContent = "error: " + (e.message || e);
            msg.className = "sx-edit-msg sx-err";
        } finally {
            btn.disabled = false;
        }
    });

    // Boot: build the agent with the (possibly-cached) identity, then
    // read /api/admin/whoami via a signed call so the principal we
    // display matches what the canister will see on an edit.
    (async () => {
        await ensureAgent();
        await refreshWhoami();
    })();

    }
</script>

@code {
    private static string FormatBytes(ulong b)
    {
        if (b < 1024UL) return b + " B";
        if (b < 1024UL * 1024UL) return (b / 1024.0).ToString("0.0") + " KiB";
        if (b < 1024UL * 1024UL * 1024UL) return (b / (1024.0 * 1024.0)).ToString("0.0") + " MiB";
        return (b / (1024.0 * 1024.0 * 1024.0)).ToString("0.00") + " GiB";
    }

    // The ImageStoreCollection.Preview field smuggles an <img> tag through
    // as the field value so the explorer can show it inline. Every other
    // field is HTML-escaped.
    private static string RenderValue(string raw)
    {
        if (raw.StartsWith("<img ", StringComparison.Ordinal)) return raw;
        return System.Net.WebUtility.HtmlEncode(raw);
    }
}
