{
  "$schema": "http://json.schemastore.org/template",
  "author": "Wasp",
  "classifications": [ "Web", "MVC", "Internet Computer" ],
  "identity": "Wasp.Templates.MvcOnIcp",
  "name": "ASP.NET Core MVC on the Internet Computer",
  "shortName": "mvc-on-icp",
  "description": "Stock dotnet new mvc shape — controllers, Razor Views, wwwroot static assets — running entirely on an IC canister.",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "MvcOnIcp",
  "preferNameDirectory": true,
  "symbols": {
    "WaspVersion": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "0.1.0-alpha",
      "replaces": "WASP_VERSION"
    }
  }
}
