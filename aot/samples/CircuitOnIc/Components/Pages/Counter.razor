@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: <span id="wasp-count">@currentCount</span></p>

<button class="btn btn-primary" @onclick="IncrementCount">
    Slow click (SignalR update call, ~1.3 s)
</button>

@code {
    // Initial render hydrates from stable memory so the span doesn't
    // flash back to 0 when Blazor's renderer kicks in 5-6 s after the
    // page paints. The fast-click path bypasses this field entirely;
    // it lives only for the slow-click (SignalR) path and to give the
    // framework's first render the right number.
    private int currentCount = CounterStableStore.Read();

    private void IncrementCount()
    {
        currentCount++;
        CounterStableStore.Write(currentCount);
    }
}
