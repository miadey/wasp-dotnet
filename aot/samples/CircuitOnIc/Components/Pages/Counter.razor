@page "/counter"

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    // Hydrate from stable memory so the count survives canister upgrades.
    private int currentCount = CounterStableStore.Read();

    private void IncrementCount()
    {
        currentCount++;
        CounterStableStore.Write(currentCount);
    }
}
