@* M4.S7 App shell — standard Blazor Server template, plus the IC-WS shim
   script tags (config + ic-websocket UMD + adapter) BEFORE blazor.web.js
   so window.WebSocket is monkey-patched by the time blazor.web.js opens
   its /_blazor connection. *@
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />

    @* IC-WebSocket plumbing: config → UMD bundle → adapter → blazor.web.js *@
    <script src="ic-ws-blazor-config.js"></script>
    <script src="ic-websocket.umd.js"></script>
    <script src="ic-ws-blazor-adapter.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
