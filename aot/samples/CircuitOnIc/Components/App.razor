@* App.razor — Wasp surface is now three @((MarkupString)…) calls
   plus the per-app fast-click bits. The Counter component below is
   100% stock from `dotnet new blazorserver`. *@

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blazor Server on IC — Counter</title>
    <HeadOutlet />
</head>

<body style="font-family: system-ui; max-width: 720px; margin: 2rem auto; padding: 0 1rem;">
    <h1 style="color: #2563eb;">Blazor Server on IC</h1>
    <p>Counter rendered server-side. Click events ride <strong>SignalR Long Polling</strong> over the canister's HTTP gateway — no WebSocket, no external services.</p>

    @* Wasp marker pair around the interactive Counter. *@
    @((MarkupString)Wasp.AspNetCore.Blazor.Server.WaspMarkers.ServerStart(typeof(WaspSample.CircuitOnIc.Components.Pages.Counter)))
    <Counter />
    @((MarkupString)Wasp.AspNetCore.Blazor.Server.WaspMarkers.ServerEnd(typeof(WaspSample.CircuitOnIc.Components.Pages.Counter)))

    @* App-specific extra: the green query-RPC fast-click button. Stays
       outside the Counter marker pair so Blazor's renderer doesn't
       strip it during hydration. *@
    <button class="btn btn-success" type="button"
            onclick="waspFastClick()"
            style="margin-top: 0.5rem;">
        Fast click (query RPC, ~15 ms)
    </button>
    <p style="margin-top: 0.5rem; color: #888;">
        <span id="wasp-fast-ms">click the green button to measure</span>
    </p>

    <hr />
    <small>SignalR transport pinned to <code>HttpTransportType.LongPolling</code> (value 4). <code>/_blazor/negotiate</code>, POST <code>/_blazor</code> (send), and GET <code>/_blazor</code> (poll) all route to this canister's <code>http_request_update</code>.</small>

    @* Wasp scripts (blazor.web.js + wasp-bridge.js). *@
    @((MarkupString)Wasp.AspNetCore.Blazor.Server.WaspMarkers.Scripts())

    @* App-specific fast-click + sync — lives in app, not framework. *@
    <script>
      let _waspLocalCount = 0;
      let _waspLastSyncedCount = 0;

      window.waspFastClick = async function () {
        const span = document.getElementById('wasp-count');
        const t0 = performance.now();
        try {
          const r = await fetch('/api/click?c=' + _waspLocalCount);
          const j = await r.json();
          _waspLocalCount = j.count;
          if (span) span.textContent = String(j.count);
          const dur = Math.round(performance.now() - t0);
          const ms = document.getElementById('wasp-fast-ms');
          if (ms) ms.textContent = 'fast click round-trip: ' + dur + ' ms (count=' + j.count
              + ', unsynced delta: ' + (j.count - _waspLastSyncedCount) + ')';
        } catch (e) {
          const ms = document.getElementById('wasp-fast-ms');
          if (ms) ms.textContent = 'fast click error: ' + e.message;
        }
      };

      // Pull persisted count on load.
      (async () => {
        try {
          const r = await fetch('/api/state');
          const j = await r.json();
          _waspLocalCount = j.count;
          _waspLastSyncedCount = j.count;
          const span = document.getElementById('wasp-count');
          if (span) span.textContent = String(j.count);
        } catch { /* cold canister */ }
      })();

      // Periodic sync — every 3 s, flush diffed count to stable memory.
      setInterval(async () => {
        if (_waspLocalCount === _waspLastSyncedCount) return;
        const target = _waspLocalCount;
        try {
          await fetch('/api/sync?c=' + target, { method: 'POST' });
          _waspLastSyncedCount = target;
          const ms = document.getElementById('wasp-fast-ms');
          if (ms && ms.textContent.includes('unsynced')) {
            ms.textContent = ms.textContent.replace(/unsynced delta: \d+/, 'persisted (synced=' + target + ')');
          }
        } catch { /* retry next tick */ }
      }, 3000);

      window.addEventListener('beforeunload', () => {
        if (_waspLocalCount !== _waspLastSyncedCount) {
          navigator.sendBeacon('/api/sync?c=' + _waspLocalCount);
        }
      });
    </script>
</body>

</html>
