@page "/counter"

@* Interactivity comes from WaspMarkers.ServerStart wrapping this
   component in App.razor — NOT from @rendermode InteractiveServer,
   which trips the framework's ServerComponentSerializer.GetTypeInfo
   reflection path (JsonSerializerIsReflectionDisabled per #76). The
   Wasp marker + CircuitHubFacade chain delivers the same interactive
   semantics without the JSON reflection. *@

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

@* id="wasp-count" is required so the wasp-bridge.js workaround for #80
   (RenderBatchWriter strings table empty for delta batches on wasm32-wasi
   AOT) can find this span and inject the post-click count value. Without
   it the framework's delta-batch DOM patch leaves the span empty. *@
<p role="status">Current count: <span id="wasp-count">@currentCount</span></p>

<button class="btn btn-primary" @onclick="IncrementCount">
    Click me
</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
