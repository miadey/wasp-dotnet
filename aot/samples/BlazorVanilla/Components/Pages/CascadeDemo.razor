@page "/cascade"

@* #85 — CascadingValue from parent → ThemedChild via named cascade. *@

<PageTitle>Cascade</PageTitle>

<h1>Cascading Values</h1>

<p>The parent provides a <code>Theme</code> via <code>&lt;CascadingValue&gt;</code>.
Nested <code>ThemedChild</code> components pick it up through a
<code>[CascadingParameter]</code> property.</p>

<div style="margin-bottom:1rem;">
    <button class="btn btn-secondary" @onclick="SetLight">Light</button>
    <button class="btn btn-secondary" @onclick="SetDark">Dark</button>
    <button class="btn btn-secondary" @onclick="SetNone">None</button>
</div>

<p>Current theme value: <code>@(theme ?? "(null)")</code></p>

<CascadingValue Value="theme" Name="Theme">
    <div style="display:flex; gap:1rem; flex-wrap:wrap;">
        <ThemedChild />
        <ThemedChild />
    </div>
</CascadingValue>

@code {
    private string? theme = "light";

    private void SetLight() => theme = "light";
    private void SetDark()  => theme = "dark";
    private void SetNone()  => theme = null;
}
