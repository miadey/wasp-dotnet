@page "/weather"

<PageTitle>Weather</PageTitle>

<h1>Weather</h1>

<p>Demonstrates async data loading in <code>OnInitializedAsync</code>.</p>

@if (forecasts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table style="border-collapse:collapse; width:100%;">
        <thead>
            <tr style="background:#f1f5f9; text-align:left;">
                <th style="padding:0.5rem;">Day</th>
                <th style="padding:0.5rem;">Temp (C)</th>
                <th style="padding:0.5rem;">Summary</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var forecast in forecasts)
            {
                <tr>
                    <td style="padding:0.5rem;">@forecast.Day</td>
                    <td style="padding:0.5rem;">@forecast.TemperatureC</td>
                    <td style="padding:0.5rem;">@forecast.Summary</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private Forecast[]? forecasts;

    protected override async Task OnInitializedAsync()
    {
        await Task.Yield();
        forecasts = new Forecast[]
        {
            new("Mon", -5, "Freezing"),
            new("Tue",  3, "Bracing"),
            new("Wed",  8, "Chilly"),
            new("Thu", 14, "Cool"),
            new("Fri", 22, "Mild"),
        };
    }

    private sealed record Forecast(string Day, int TemperatureC, string Summary);
}
