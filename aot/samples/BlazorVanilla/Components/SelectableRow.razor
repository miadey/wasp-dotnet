@* Child component for EventCallbackDemo. Raises a typed
   EventCallback<int> when clicked. *@

<div @onclick="OnClick"
     style="cursor:pointer; padding:0.5rem 0.75rem; border:1px solid #cbd5f5;
            border-radius:4px; margin-bottom:0.25rem;
            background:@(IsSelected ? "#bfdbfe" : "transparent");">
    Row #@Id — @Label
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<int> OnSelected { get; set; }

    private Task OnClick() => OnSelected.InvokeAsync(Id);
}
