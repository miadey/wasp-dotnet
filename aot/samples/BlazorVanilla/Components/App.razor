@* App.razor — manual router. Bypasses the stock <Router>/<RouteView>
   pipeline which currently NREs in StaticHtmlRenderer.RenderAttributes
   (gh #107). Switching on NavigationManager.Uri lets the harness exercise
   the per-page SSR while #107 stays open as a framework bug.

   Restore <Routes /> once #107 closes. *@

@inject NavigationManager Nav
@using WaspSample.BlazorVanilla.Components.Pages

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blazor Vanilla on IC</title>
    <base href="/" />
</head>

<body>
    @{
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).TrimStart('/').Split('?')[0];
        Type pageType = path switch
        {
            "/counter" => typeof(Counter),
            _ => typeof(Home),
        };
    }
    @((MarkupString)Wasp.AspNetCore.Blazor.Server.WaspMarkers.ServerStart(pageType))
    @if (pageType == typeof(Counter))
    {
        <Counter />
    }
    else
    {
        <Home />
    }
    @((MarkupString)Wasp.AspNetCore.Blazor.Server.WaspMarkers.ServerEnd(pageType))

    @((MarkupString)Wasp.AspNetCore.Blazor.Server.WaspMarkers.Scripts())
</body>

</html>
