@* Child component for CascadeDemo. Reads the ambient Theme via
   [CascadingParameter] and renders accordingly. *@

<div style="padding:1rem; border-radius:6px; background:@BackgroundColor; color:@ForegroundColor;">
    <strong>ThemedChild</strong> — current theme:
    <code>@(Theme ?? "(none)")</code>
</div>

@code {
    [CascadingParameter(Name = "Theme")]
    public string? Theme { get; set; }

    private string BackgroundColor => Theme switch
    {
        "dark" => "#0f172a",
        "light" => "#f8fafc",
        _ => "#e0e7ff",
    };

    private string ForegroundColor => Theme switch
    {
        "dark" => "#f8fafc",
        _ => "#0f172a",
    };
}
