<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Copy the golden test vector next to the binary so Program.cs finds it. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- Audited blst binding (desktop/native only — NO browser-wasm RID). -->
    <PackageReference Include="Nethermind.Crypto.Bls" Version="1.0.5" />
  </ItemGroup>
  <ItemGroup>
    <None Update="vetkd_golden.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>
</Project>
