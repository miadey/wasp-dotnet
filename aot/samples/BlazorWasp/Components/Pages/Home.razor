</section>

@code {
    // Live canister id — the page is served by this canister; never hardcoded.
    private readonly string canisterId = WaspSample.BlazorWasp.AdminService.CanisterIdText();

    // Monoline glyph + the reusable "certified" seal, currentColor, inline SVG.
    private MarkupString Svg(string body, int s = 22) => (MarkupString)
        $"<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round' width='{s}' height='{s}' aria-hidden='true'>{body}</svg>";

    private MarkupString Seal(int s = 16) => (MarkupString)
        $"<svg class='sg-seal' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round' width='{s}' height='{s}' aria-hidden='true'><path d='M12 2l7 4v6c0 4-3 7-7 8-4-1-7-4-7-8V6z'/><path d='M9 12l2 2 4-4'/></svg>";

    // The faux chat window — server rail, channel list, message canvas, composer.
    // wide=true widens the rail/channel columns for the big-visual beat.
    private MarkupString MockWindow(bool wide)
    {
        var cls = wide ? "sg-mock wide" : "sg-mock";
        var lk = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' width='12' height='12'><rect x='5' y='11' width='14' height='9' rx='2'/><path d='M8 11V8a4 4 0 0 1 8 0v3'/></svg>";
        var threadIco = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='13' height='13'><polyline points='9 14 4 9 9 4'/><path d='M20 20v-7a4 4 0 0 0-4-4H4'/></svg>";
        var sealInline = "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='11' height='11'><path d='M12 2l7 4v6c0 4-3 7-7 8-4-1-7-4-7-8V6z'/><path d='M9 12l2 2 4-4'/></svg>";
        var pinBan = wide
            ? "<div class='sg-pin'><span class='ic'><svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round' width='13' height='13'><path d='M12 17v5'/><path d='M9 3h6l-1 6 3 3H7l3-3-1-6z'/></svg></span> Pinned: read the canister, don't trust us.</div>"
            : "";
        var reply = wide
            ? "<div class='sg-reply'><div class='sg-msg'><span class='sg-av d'>J</span><div><span class='sg-mname'>Jun</span><span class='sg-mtime'>9:44</span><p class='sg-mtext'>verified — receipts are on-chain</p></div></div></div>"
            : "";
        return (MarkupString)(
            $"<div class='{cls}'>" +
              "<div class='sg-mr'><span class='sg-mr-i on'>B</span><span class='sg-mr-i'>◆</span><span class='sg-mr-i'>✦</span><span class='sg-mr-i'>+</span></div>" +
              "<div class='sg-chan'>" +
                "<div class='sg-chan-h'><span>WASP Bzzz</span></div>" +
                "<div class='sg-ch on'><span class='h'>#</span>&nbsp;general</div>" +
                "<div class='sg-ch'><span class='h'>#</span>&nbsp;design</div>" +
                "<div class='sg-ch'><span class='h'>#</span>&nbsp;launch</div>" +
                $"<div class='sg-ch lock'><span class='h'>#</span>&nbsp;founders <span class='lk'>{lk}</span></div>" +
              "</div>" +
              "<div class='sg-conv'>" +
                $"<div class='sg-conv-h'><span class='h'>#</span>&nbsp;general <span class='sg-cert'>{sealInline} signed</span></div>" +
                pinBan +
                "<div class='sg-msgs'>" +
                  "<div class='sg-msg'><span class='sg-av a'>A</span><div><span class='sg-mname'>Ada<span class='role owner'>Owner</span></span><span class='sg-mtime'>9:41</span><p class='sg-mtext'>shipping the on-chain build today <span class='sg-tag'>#launch</span></p></div></div>" +
