@* ── Final CTA ──────────────────────────────────────────── *@
<section class="sg-final">
    <div class="sg-final-grid" aria-hidden="true"></div>
    <div class="sg-final-glow" aria-hidden="true"></div>
    <span class="sg-watermark" aria-hidden="true">@Seal(220)</span>
    <div class="sg-final-in">
        <span class="sg-eyebrow"><span class="sg-dot"></span>Free · No paid plan</span>
        <h2 class="sg-h2">Your community. Your identity.<br />On a chain you can <span class="sg-grad">verify</span>.</h2>
        <div class="sg-cta-row">
            <button type="button" class="sg-btn sg-btn-primary ii-signin" data-ii-signin><span class="ii-mark">∞</span> Sign in with Internet Identity</button>
