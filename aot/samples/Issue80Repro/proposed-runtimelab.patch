diff --git a/src/coreclr/jit/llvmcodegen.cpp b/src/coreclr/jit/llvmcodegen.cpp
index 66f60e0d..df59b6ab 100644
--- a/src/coreclr/jit/llvmcodegen.cpp
+++ b/src/coreclr/jit/llvmcodegen.cpp
@@ -2465,7 +2465,26 @@ void Llvm::storeObjAtAddress(Value* baseAddress, Value* data, StructDesc* struct
             }
         }
 
-        bytesStored += static_cast<unsigned>(fieldData->getType()->getPrimitiveSizeInBits() / BITS_PER_BYTE);
+        // bytesStored tracking: getPrimitiveSizeInBits returns 0 for
+        // PointerType (LLVM doesn't classify pointers as "primitive"
+        // in its size API). Without the explicit pointer-size fallback
+        // below, bytesStored fails to advance past any reference-typed
+        // field, and the next iteration's padding-fill memcpy (using
+        // fieldOffset > bytesStored as the guard) overwrites the
+        // just-stored pointer with stale destination bytes. This
+        // manifested as RenderTreeFrame's offset-16 string field being
+        // zeroed after a struct-copy on wasm32-wasi.
+        unsigned fieldByteSize;
+        if (fieldData->getType()->isPointerTy())
+        {
+            fieldByteSize = m_context->Module.getDataLayout().getPointerSize();
+        }
+        else
+        {
+            fieldByteSize = static_cast<unsigned>(
+                fieldData->getType()->getPrimitiveSizeInBits() / BITS_PER_BYTE);
+        }
+        bytesStored += fieldByteSize;
     }
 
     unsigned llvmStructSize = static_cast<unsigned>(data->getType()->getPrimitiveSizeInBits() / BITS_PER_BYTE);
