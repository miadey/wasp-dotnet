@page "/contacts"
@inject ApiClient Api
@inject NavigationManager Nav

<PageTitle>Contacts · Wasp CRM</PageTitle>

<div class="contacts-header">
    <h1>Contacts</h1>
    <div class="contacts-actions">
        <input class="input search" type="text" @bind="_search" @bind:event="oninput"
               @bind:after="Search" placeholder="Search by name, email, company…" />
        <button class="btn btn-accent" @onclick="OpenNewContact">+ New contact</button>
    </div>
</div>

@if (_loading)
{
    <div class="loading">Loading…</div>
}
else if (_contacts.Length == 0)
{
    <div class="empty">
        <h2>No contacts yet</h2>
        <p>Click <strong>+ New contact</strong> to add your first one.</p>
    </div>
}
else
{
    <table class="grid">
        <thead>
            <tr>
                <th style="width:40px"></th>
                <th>Name</th>
                <th>Email</th>
                <th>Company</th>
                <th>Title</th>
                <th>Tags</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in PageItems())
            {
                <tr class="grid-row" @onclick="() => Open(c)">
                    <td><div class="avatar-mini" style="@HueStyle(c.DisplayName)">@c.Initials</div></td>
                    <td><strong>@c.DisplayName</strong></td>
                    <td>@c.Email</td>
                    <td>@c.Company</td>
                    <td>@c.Title</td>
                    <td>
                        <div class="tag-row">
                            @foreach (var t in c.TagList.Take(3)) { <span class="tag">@t</span> }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pager">
        <button @onclick="Prev" disabled="@(_page == 0)">‹ Prev</button>
        <span class="pager-info">
            @(_page * _pageSize + 1)–@Math.Min((_page + 1) * _pageSize, _contacts.Length) of @_contacts.Length
        </span>
        <button @onclick="Next" disabled="@((_page + 1) * _pageSize >= _contacts.Length)">Next ›</button>
    </div>
}

@if (_showNew)
{
    <ContactEditDialog Contact="_draft"
                       Title="New contact"
                       PrimaryLabel="Create"
                       OnSave="OnNewSaved"
                       OnCancel="() => _showNew = false" />
}

@code {
    Contact[] _contacts = Array.Empty<Contact>();
    bool _loading = true;
    string _search = "";
    bool _showNew = false;
    Contact _draft = new();
    int _page = 0;
    const int _pageSize = 25;

    IEnumerable<Contact> PageItems() => _contacts.Skip(_page * _pageSize).Take(_pageSize);
    void Prev() { if (_page > 0) _page--; }
    void Next() { if ((_page + 1) * _pageSize < _contacts.Length) _page++; }

    protected override async Task OnInitializedAsync() => await Load();

    async Task Load()
    {
        _loading = true;
        _contacts = await Api.ListContactsAsync(string.IsNullOrWhiteSpace(_search) ? null : _search);
        if (_page * _pageSize >= _contacts.Length) _page = 0;
        _loading = false;
    }

    async Task Search() { _page = 0; await Load(); }

    void Open(Contact c) => Nav.NavigateTo($"/crm/contacts/{c.Id}");

    void OpenNewContact()
    {
        _draft = new Contact();
        _showNew = true;
    }

    async Task OnNewSaved(Contact c)
    {
        var saved = await Api.CreateContactAsync(c);
        _showNew = false;
        if (saved is not null)
        {
            await Load();
            Nav.NavigateTo($"/crm/contacts/{saved.Id}");
        }
    }

    int HueFor(string s)
    {
        int h = 0;
        foreach (var c in s) h = (h * 131 + c) & 0xFFFFFF;
        return h % 360;
    }
    string HueStyle(string s) => $"background: hsl({HueFor(s)}, 50%, 50%);";
}
