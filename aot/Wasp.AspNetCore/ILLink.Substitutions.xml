<?xml version="1.0" encoding="UTF-8" ?>
<linker>
  <!-- Trim-time method-body replacement.
       Background: ASP.NET Core's HostApplicationBuilder always creates a
       PhysicalFileProvider for ContentRoot. PhysicalFileProvider.ctor calls
       Directory.Exists(root); if false, throws DirectoryNotFoundException.
       On a canister there is no real filesystem — wasi-stub returns EBADF for
       all preopens, so Directory.Exists returns false, and the exception
       propagates out of the [ModuleInitializer], trapping the canister.

       Stubbing Directory.Exists to return true lets PhysicalFileProvider
       construct successfully. The provider is never actually read in our
       hello sample (no static files, no Razor — that's M2/M3 territory),
       so the lie is harmless here.

       When M2 (Razor SSR) needs real wwwroot reads, replace the file
       provider with an embedded-resource one (issue #53) instead. -->
  <assembly fullname="System.Private.CoreLib">
    <type fullname="System.IO.Directory">
      <method signature="System.Boolean Exists(System.String)" body="stub" value="true" />
    </type>
  </assembly>

  <!-- Stub the entire PhysicalFileProvider ctor chain. The ctor calls
       Path.GetFullPath, regex setup, and a Lazy<PhysicalFilesWatcher> all
       of which can fail in subtle ways on canister. We never actually read
       static files in the hello sample, so a no-op ctor is fine. M2 (#52)
       replaces the file provider entirely with an embedded-resource one. -->
  <assembly fullname="Microsoft.Extensions.FileProviders.Physical">
    <!-- Class is in namespace Microsoft.Extensions.FileProviders (NOT .Physical
         despite the assembly name); ExclusionFilters is in the .Physical sub. -->
    <type fullname="Microsoft.Extensions.FileProviders.PhysicalFileProvider">
      <method signature="System.Void .ctor(System.String)" body="stub" />
      <method signature="System.Void .ctor(System.String,Microsoft.Extensions.FileProviders.Physical.ExclusionFilters)" body="stub" />
    </type>
  </assembly>

  <!-- DataProtection KeyManagementOptions..ctor() — pulled in transitively by
       AddAuthentication (#51 finding) and AddRazorComponents (#54 finding).
       The ctor's field initializers reference TimeSpan.FromMilliseconds(long),
       which the trimmer removes (only the (double) overload survives in the
       reachable graph). Result: ILC marks the ctor "will always throw"; service
       graph resolution at Host.StartAsync trips Arg_TargetInvocationException.
       Stubbing the ctor leaves the type with all-default fields. Safe as long
       as we don't *use* data protection (no encrypted cookies, no antiforgery
       tokens), which is fine for canister apps — there's no shared secret to
       protect anyway. -->
  <assembly fullname="Microsoft.AspNetCore.DataProtection">
    <type fullname="Microsoft.AspNetCore.DataProtection.KeyManagement.KeyManagementOptions">
      <method signature="System.Void .ctor()" body="stub" />
    </type>
    <!-- KeyManagementOptionsSetup.Configure reads fields on the
         options instance that our ctor stub left null (AuthenticatedEncryptor
         configuration, key escrow sinks, etc.) and NullRefs at startup.
         No-op the configure pass; we don't use DataProtection anyway. -->
    <type fullname="Microsoft.AspNetCore.DataProtection.Internal.KeyManagementOptionsSetup">
      <method signature="System.Void Configure(Microsoft.AspNetCore.DataProtection.KeyManagement.KeyManagementOptions)" body="stub" />
    </type>
  </assembly>

  <!-- AntiforgeryOptionsSetup.Configure → ComputeCookieName → SHA256.HashData,
       which is unsupported on wasm32-wasi (PlatformNotSupportedException).
       Stubbing Configure leaves AntiforgeryOptions at defaults; consumer must
       set Cookie.Name themselves via services.Configure<AntiforgeryOptions>. -->
  <assembly fullname="Microsoft.AspNetCore.Antiforgery">
    <type fullname="Microsoft.AspNetCore.Antiforgery.AntiforgeryOptionsSetup">
      <method signature="System.Void Configure(Microsoft.AspNetCore.Antiforgery.AntiforgeryOptions)" body="stub" />
    </type>
  </assembly>

  <!-- TypeNameHash.Compute(Type) calls SHA256.HashData to generate stable
       marker keys for @rendermode InteractiveServer components. SHA256
       isn't supported on wasm32-wasi (PlatformNotSupportedException).
       Stub the static SHA256.HashData(ReadOnlySpan, Span) overload to a
       no-op (Span output stays zero-filled). The resulting hash is a
       constant per render but stable across requests — good enough for
       marker keys (which are scoped per-circuit anyway). -->

  <!-- Regex engine entry points. The framework references regex via
       routing patterns + DataAnnotations (EmailAddress, RegularExpression
       attributes — #108). Neither BlazorVanilla nor CircuitOnIc has
       any [Regex]/[EmailAddress] attributes, and our route patterns
       are simple. Stubbing the engine ctors to throw means the
       trimmer can drop the engine's match/compile pipelines.
       Note: if the user later adds a [RegularExpression] attribute,
       this stub would surface at startup with a clear failure. -->
  <assembly fullname="System.Text.RegularExpressions">
    <type fullname="System.Text.RegularExpressions.RegexInterpreter">
      <method signature="System.Void .ctor(System.Text.RegularExpressions.RegexInterpreterCode,System.Globalization.CultureInfo)" body="stub" />
    </type>
  </assembly>

  <!-- DataProtection AuthenticatedEncryptor — we already stub
       KeyManagementOptions.ctor + .Configure, but the actual encryptor
       Encrypt/Decrypt method bodies remain. Stub the data-flow paths.
       Safe: we don't use DataProtection (no encrypted cookies, no
       antiforgery — see UseIcDataProtection). -->
  <assembly fullname="Microsoft.AspNetCore.DataProtection">
    <type fullname="Microsoft.AspNetCore.DataProtection.AuthenticatedEncryption.ConfigurationModel.AuthenticatedEncryptorConfiguration">
      <method signature="System.Void Validate()" body="stub" />
    </type>
  </assembly>

  <!-- ValueStopwatch.GetElapsedTime() throws when StartNew was never called
       (the default-struct state). On wasm32-wasi, Stopwatch.GetTimestamp()
       returns 0 after wasi-stub no-ops __wasi_clock_time_get — so even
       StartNew-then-GetElapsedTime hits the !IsActive throw. Several
       framework paths trip this on every request:
         - MVC: ViewResultExecutor.FindView for view-selection diagnostics
         - Blazor: RemoteRenderer.ProcessPendingBatch for batch timing (#112)
       Stubbing the instance method to default(TimeSpan)=Zero is harmless
       for the diagnostic listeners that consume it. ValueStopwatch is an
       internal shared-source struct with one copy in each assembly that
       needs it — substitute each one.
       Note: ILC alpha 10.0.0 does not support int64 value substitutions,
       so we cannot substitute Stopwatch.GetTimestamp() at the root. -->
  <assembly fullname="Microsoft.AspNetCore.Mvc.Core">
    <type fullname="Microsoft.Extensions.Internal.ValueStopwatch">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
  </assembly>
  <assembly fullname="Microsoft.AspNetCore.Components.Server">
    <type fullname="Microsoft.Extensions.Internal.ValueStopwatch">
      <method signature="System.Boolean get_IsActive()" body="stub" value="true" />
    </type>
  </assembly>

  <!-- EventSource.IsEnabled() gates all framework ETW/EventListener
       emission. Forcing false to constant lets AOT see the gated
       WriteEvent paths as unreachable and (where the trimmer can prove
       it) drop them. No application of ours subscribes to EventSource. -->
  <assembly fullname="System.Private.CoreLib">
    <type fullname="System.Diagnostics.Tracing.EventSource">
      <method signature="System.Boolean IsEnabled()" body="stub" value="false" />
    </type>
  </assembly>

  <!-- Activity / ActivitySource — distributed-tracing API. Canister has
       no tracer backend; stubbing AnyListeners to false makes the
       tracer fast-path become "no listeners, skip event construction". -->
  <assembly fullname="System.Diagnostics.DiagnosticSource">
    <type fullname="System.Diagnostics.ActivitySource">
      <method signature="System.Boolean HasListeners()" body="stub" value="false" />
    </type>
  </assembly>

  <!-- DiagnosticListener.IsEnabled gates all framework diagnostic-event
       emission paths (MVC's ViewResult execution events, Blazor's render
       batch lifecycle, HttpClient request events, etc.). The framework
       wraps every IsEnabled-returns-false branch with the actual event
       payload construction; stubbing the gate to false makes the trimmer
       drop all the payload-building code. No application of ours reads
       these events, so this is a pure dead-code prune. -->
  <assembly fullname="System.Diagnostics.DiagnosticSource">
    <type fullname="System.Diagnostics.DiagnosticListener">
      <method signature="System.Boolean IsEnabled()" body="stub" value="false" />
      <method signature="System.Boolean IsEnabled(System.String)" body="stub" value="false" />
      <method signature="System.Boolean IsEnabled(System.String,System.Object,System.Object)" body="stub" value="false" />
    </type>
  </assembly>

  <!-- PersistentServicesRegistry is hit on every Razor render via
       EndpointHtmlRenderer.InitializeStandardComponentServicesAsync. Its
       ComputeKey calls SHA256.HashData. M2 (SSR-only) does not need persistent
       component state — that's an M3 thing (WASM hydration). No-op the
       Register/Restore methods. -->
  <assembly fullname="Microsoft.AspNetCore.Components">
    <type fullname="Microsoft.AspNetCore.Components.Infrastructure.PersistentServicesRegistry">
      <method signature="System.Void RegisterForPersistence(Microsoft.AspNetCore.Components.PersistentComponentState)" body="stub" />
      <!-- gh #99 (M4.S9.5e): RestoreStateAsync(IPersistentComponentStateStore) was renamed
           to RestoreInstanceState(object, Type, PersistentComponentState) in
           Microsoft.AspNetCore.App 10.0.8. -->
      <method signature="System.Void RestoreInstanceState(System.Object,System.Type,Microsoft.AspNetCore.Components.PersistentComponentState)" body="stub" />
    </type>
  </assembly>
</linker>
